# Copy this file to .env.local and adjust if your backend runs on a
# different port. Never commit .env.local -- see the root .gitignore.
#
# This is public configuration (a URL), not a secret: it is inlined into
# the browser bundle by Next.js because it is prefixed NEXT_PUBLIC_. Never
# put a credential in a NEXT_PUBLIC_ variable.
#
# Default matches `uvicorn app.main:app --port 8000` (backend/Dockerfile's
# own default). If you're running the repo's docker-compose stack with
# BACKEND_PORT=18000 (see the root .env), use that port here instead.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
