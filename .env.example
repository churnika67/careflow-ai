# Local development only. Replace this password before shared use.
POSTGRES_PORT=55432
POSTGRES_DB=careflow
POSTGRES_USER=careflow
POSTGRES_PASSWORD=careflow_local_only
# Native Python uses host ports. Compose overrides these with service DNS names.
DATABASE_URL=postgresql://careflow:careflow_local_only@localhost:55432/careflow
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=local
HEALTH_TIMEOUT_SECONDS=3

# Generation defaults to an offline test double, not a language model.
RAG_PROVIDER=deterministic
# Used only when RAG_PROVIDER=openai. Credentials are never needed for mock tests.
RAG_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
RAG_PROVIDER_TIMEOUT_SECONDS=30
RAG_TOP_K=5
# Development heuristic, not confidence or a calibrated probability.
RAG_MIN_SCORE=0.6
RAG_CONTEXT_CHARS=24000
RAG_MODEL_CACHE=.cache/models
RAG_EMBEDDING_OFFLINE=true
RAG_QDRANT_ALIAS=careflow_cms_ncd
# Optional host-port overrides when another project occupies the defaults.
BACKEND_PORT=8000
QDRANT_PORT=6333
REDIS_PORT=6379
# Retrieval scores are not confidence; dense remains the comparison baseline.
RETRIEVAL_MODE=dense
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_RRF_CONSTANT=60
BM25_K1=1.2
BM25_B=0.75
# Optional cross-encoder; download its pinned checkpoint before offline use.
RERANK_ENABLED=false
RERANK_CANDIDATE_K=10
RERANK_MODEL_CACHE=.cache/models
RERANK_OFFLINE=true
